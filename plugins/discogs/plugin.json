{
  "id": "discogs",
  "name": "Discogs",
  "version": "1.0",
  "api": 1,
  "author": "MarKusSXCH TagStudio",
  "description": "Discogs-Datenbank mit eigenem, kostenlosem Token: Veröffentlichung mit Label, Katalognummer, Stil, Datum, Trackliste und Cover. Anleitung unter „Schlüssel …“. Wird von „Online-Metadaten“ genutzt.",
  "notes": "Keine Zusatzpakete nötig.",
  "fields": [
    "TXXX:DISCOGS_RELEASE_ID"
  ],
  "service": {
    "name": "Discogs API",
    "kind": "online",
    "home": "https://www.discogs.com",
    "docs": "https://www.discogs.com/developers",
    "base": "https://api.discogs.com",
    "auth": "token",
    "auth_note": "Persönlicher Token (discogs.com › Einstellungen › Entwickler); verschlüsselt gespeichert.",
    "limits": "mit Token 60 Anfragen/min",
    "terms": "https://support.discogs.com/hc/articles/360009334593",
    "endpoints": [
      {
        "id": "search",
        "method": "GET",
        "path": "/database/search",
        "label": "Datenbank durchsuchen",
        "status": "partial",
        "use": "Online-Metadaten: Veröffentlichungen zu Titel + Künstler",
        "note": "genutzt: type=release, track, artist",
        "params": [
          {
            "name": "type",
            "default": "release"
          },
          {
            "name": "track",
            "default": "",
            "example": "One More Time"
          },
          {
            "name": "artist",
            "default": "",
            "example": "Daft Punk"
          },
          {
            "name": "q",
            "default": ""
          },
          {
            "name": "per_page",
            "default": "5"
          }
        ]
      },
      {
        "id": "release",
        "method": "GET",
        "path": "/releases/{id}",
        "label": "Eine Veröffentlichung",
        "status": "full",
        "use": "Details: Label, Katalognummer, Stil, Datum, Trackliste, Cover",
        "params": [
          {
            "name": "id",
            "example": "2879"
          }
        ]
      },
      {
        "id": "master",
        "method": "GET",
        "path": "/masters/{id}",
        "label": "Master-Veröffentlichung",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "26647"
          }
        ]
      },
      {
        "id": "master-versions",
        "method": "GET",
        "path": "/masters/{id}/versions",
        "label": "Alle Fassungen eines Masters",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "26647"
          }
        ]
      },
      {
        "id": "artist",
        "method": "GET",
        "path": "/artists/{id}",
        "label": "Künstler",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "1289"
          }
        ]
      },
      {
        "id": "artist-releases",
        "method": "GET",
        "path": "/artists/{id}/releases",
        "label": "Veröffentlichungen eines Künstlers",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "1289"
          }
        ]
      },
      {
        "id": "label",
        "method": "GET",
        "path": "/labels/{id}",
        "label": "Label",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "750"
          }
        ]
      },
      {
        "id": "label-releases",
        "method": "GET",
        "path": "/labels/{id}/releases",
        "label": "Veröffentlichungen eines Labels",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "750"
          }
        ]
      },
      {
        "id": "identity",
        "method": "GET",
        "path": "/oauth/identity",
        "label": "Eigene Identität (Token prüfen)",
        "status": "full",
        "use": "Verbindung testen",
        "params": []
      },
      {
        "id": "collection",
        "method": "GET",
        "path": "/users/{username}/collection/folders/0/releases",
        "label": "Eigene Sammlung",
        "status": "none",
        "params": [],
        "note": "username: dein Discogs-Name – steht in der Antwort von „identity“."
      },
      {
        "id": "wantlist",
        "method": "GET",
        "path": "/users/{username}/wants",
        "label": "Eigene Wunschliste",
        "status": "none",
        "params": [],
        "note": "username: dein Discogs-Name – steht in der Antwort von „identity“."
      },
      {
        "id": "marketplace",
        "method": "GET",
        "path": "/marketplace/stats/{release_id}",
        "label": "Marktplatz-Statistik",
        "status": "none",
        "params": [
          {
            "name": "release_id",
            "example": "2879"
          }
        ]
      }
    ],
    "example": {
      "artist": "Daft Punk",
      "title": "One More Time",
      "album": "Discovery"
    }
  }
}
