        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "1"
          }
        ],
        "note": "ohne Künstler und Veröffentlichungen – dafür die eigenen Listen-Endpunkte"
      },
      {
        "id": "label-releases",
        "method": "GET",
        "path": "/v1/labels/{id}/releases",
        "label": "Veröffentlichungen eines Labels",
        "status": "partial",
        "note": "neueste zuerst (#258); blättern mit cursor/next_cursor (bis 10 000 Ergebnisse)",
        "params": [
          {
            "name": "id",
            "example": "1"
          }
        ],
        "use": "Entdecken: neue Veröffentlichungen (from, limit)"
      },
      {
        "id": "label-artists",
        "method": "GET",
        "path": "/v1/labels/{id}/artists",
        "label": "Künstler eines Labels",
        "status": "none",
        "params": [
          {
            "name": "id",
            "example": "1"
          }
        ],
        "note": "blättern mit cursor/next_cursor (bis 10 000 Ergebnisse)"
      },
      {
        "id": "releases-search",
        "method": "GET",
        "path": "/v1/releases/search",
        "label": "Veröffentlichungen suchen",
        "status": "none",
        "params": [
          {
            "name": "title",
            "example": "Discovery"
          },
          {
            "name": "artist",
            "example": "Daft Punk"
          }
