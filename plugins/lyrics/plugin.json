{
  "id": "lyrics",
  "name": "Liedtexte",
  "version": "1.0",
  "min_app": "4.8.0",
  "category": "online",
  "api": 1,
  "author": "MarKusSXCH TagStudio",
  "description": "Lädt Liedtexte von LRCLIB (lrclib.net, frei, ohne Schlüssel) – normaler Text in USLT, synchronisierter Text in SYLT, auf Wunsch zusätzlich als .lrc-Datei neben dem MP3. Mit Vorschau; vorhandene Liedtexte werden nie ohne dein Häkchen ersetzt.",
  "notes": "Keine Zusatzpakete nötig. Liedtexte sind urheberrechtlich geschützt – nur für den eigenen Gebrauch.",
  "fields": [
    "TXXX:LRCLIB_ID"
  ],
  "service": {
    "name": "LRCLIB",
    "kind": "online",
    "home": "https://lrclib.net",
    "docs": "https://lrclib.net/docs",
    "base": "https://lrclib.net/api",
    "auth": "none",
    "limits": "höflich: höchstens 2 Anfragen/s, nacheinander",
    "note": "Liedtexte von Nutzern beigetragen; keine ISRC-Suche. Liedtexte sind urheberrechtlich geschützt – nur eigener Gebrauch.",
    "endpoints": [
      {
        "id": "get",
        "method": "GET",
        "path": "/get",
        "label": "Liedtext genau abfragen (Künstler, Titel, Album, Dauer)",
        "status": "full",
        "use": "Liedtexte: Stufe 1",
        "params": [
          {
            "name": "artist_name",
            "default": "",
            "required": true,
            "example": "Daft Punk"
          },
          {
            "name": "track_name",
            "default": "",
            "required": true,
            "example": "One More Time"
          },
          {
            "name": "album_name",
            "default": "",
            "required": true,
            "example": "Discovery"
          },
          {
            "name": "duration",
            "default": "",
            "required": true,
            "label": "duration (Sekunden)",
            "example": "320"
          }
        ]
      },
      {
        "id": "search",
        "method": "GET",
        "path": "/search",
        "label": "Liedtexte suchen (Titel/Künstler oder Freitext)",
        "status": "full",
        "use": "Liedtexte: Stufe 2 und 3",
        "params": [
          {
            "name": "q",
            "default": "",
            "label": "q (Freitext)"
          },
          {
            "name": "track_name",
            "default": "",
            "example": "One More Time"
          },
          {
            "name": "artist_name",
            "default": "",
            "example": "Daft Punk"
          },
          {
            "name": "album_name",
            "default": ""
          }
        ]
      },
      {
        "id": "get-id",
        "method": "GET",
        "path": "/get/{id}",
        "label": "Liedtext über die LRCLIB-ID",
        "status": "none",
        "use": "",
        "note": "ID wird als TXXX:LRCLIB_ID gespeichert, aber noch nicht wieder abgefragt",
        "params": [
          {
            "name": "id",
            "example": "36988937"
          }
        ]
      },
      {
        "id": "get-cached",
        "method": "GET",
        "path": "/get-cached",
        "label": "Nur aus dem Zwischenspeicher (ohne externe Quellen)",
        "status": "none",
        "params": [
          {
            "name": "artist_name",
            "default": "",
            "example": "Daft Punk"
          },
          {
            "name": "track_name",
            "default": "",
            "example": "One More Time"
          },
          {
            "name": "album_name",
            "default": "",
            "example": "Discovery"
          },
          {
            "name": "duration",
            "default": "",
            "example": "320"
          }
        ],
        "note": "Antwortet nur für Titel, die LRCLIB bereits zwischengespeichert hat – „nicht gefunden“ (404) ist hier normal."
      },
      {
        "id": "request-challenge",
        "method": "POST",
        "path": "/request-challenge",
        "label": "Herausforderung für das Veröffentlichen holen",
        "status": "none",
        "note": "nur zum Beitragen eigener Liedtexte",
        "params": []
      },
      {
        "id": "publish",
        "method": "POST",
        "path": "/publish",
        "label": "Liedtext veröffentlichen",
        "status": "none",
        "note": "TagStudio lädt nichts hoch",
        "params": []
      }
    ],
    "example": {
      "artist": "Daft Punk",
      "title": "One More Time",
      "duration": "5:20"
    }
  }
}
